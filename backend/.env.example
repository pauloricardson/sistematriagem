# ==============================================================
# COPIE ESTE ARQUIVO PARA ".env" E PREENCHA OS VALORES
# ==============================================================

# URL de conexão do MongoDB Atlas (troque <db_password> pela senha real
# do usuário do banco criado no Atlas: pauloricardsonsilvacosta_db_user)
MONGODB_URI=mongodb+srv://pauloricardsonsilvacosta_db_user:<db_password>@sistematriagemdb.vgid004.mongodb.net/?appName=sistematriagemdb
MONGODB_DB=sistematriagem

# Chave secreta usada para assinar os tokens JWT (gere uma longa e aleatória)
JWT_SECRET=troque-esta-chave-por-uma-string-longa-e-aleatoria

# URL onde o frontend está publicado (GitHub Pages) - usada no CORS
# e nos links de redefinição de senha
FRONTEND_URL=https://SEU-USUARIO.github.io/sistematriagem

# Porta do servidor (a Render injeta a própria via variável PORT)
PORT=3000

# Credenciais do primeiro administrador (Centro de Especialidades),
# criado automaticamente na primeira vez que o servidor sobe
ADMIN_EMAIL=admin@centro.local
ADMIN_SENHA=Trocar@123
ADMIN_NOME=Administrador do Centro de Especialidades

# --- Envio de e-mail para redefinição de senha (SMTP) ---
# Exemplo com Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587,
# SMTP_USER=seuemail@gmail.com, SMTP_PASS=senha-de-app (não a senha normal)
# Se deixar em branco, o link de redefinição aparece no console do servidor.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Sistema de Triagem <nao-responder@centro.local>"
